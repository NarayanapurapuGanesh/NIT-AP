# Application Core Configuration
APP_NAME="resume-parser-v2"
APP_ENV="development" # Options: development, testing, production
DEBUG=true
API_V1_STR="/api/v1"
SECRET_KEY="change_this_to_a_secure_random_string_in_production"

# Server Execution Settings
HOST="0.0.0.0"
PORT=8000
WORKERS=1

# Security & CORS
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000"
ALLOWED_HOSTS="*"

# Logging
LOG_LEVEL="INFO" # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_JSON_FORMAT=false # Set to true in production for JSON logs

# Future Vector Engine / Storage Integration Stubs
QDRANT_HOST="localhost"
QDRANT_PORT=6333
MINIO_ENDPOINT="localhost:9000"
OLLAMA_BASE_URL="http://localhost:11434"
