# FacultyIQ Video Evidence Extraction Service — Environment Variables
# Copy to .env and customize for your environment.

# Server
VIDEO_AGENT_HOST=0.0.0.0
VIDEO_AGENT_PORT=8005

# Whisper Model (tiny, base, small, medium, large-v3)
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto

# Voice Analysis (true/false)
VOICE_ANALYSIS_ENABLED=false

# GPU
GPU_ENABLED=true
GPU_PREFER_CUDA=true

# Logging
LOG_LEVEL=INFO
