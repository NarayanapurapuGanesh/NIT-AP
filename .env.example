# ==============================================================================
# FacultyIQ - Environment Configuration Template
# ==============================================================================

# Application Environment
ASPNETCORE_ENVIRONMENT=Development
NODE_ENV=development

# ASP.NET Core API Settings
API_PORT=7150
API_HTTP_PORT=5150

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=facultyiq_dev
POSTGRES_USER=facultyiq
POSTGRES_PASSWORD=facultyiq_secure_password_123!
DATABASE_CONNECTION_STRING=Host=localhost;Port=5432;Database=facultyiq_dev;Username=facultyiq;Password=facultyiq_secure_password_123!

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_password_123!
REDIS_CONNECTION_STRING=localhost:6379,password=redis_secure_password_123!

# Qdrant Vector Database
QDRANT_HOST=http://localhost
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_ENDPOINT=http://localhost:6333

# MinIO Object Storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_secure_123!
MINIO_BUCKET_NAME=facultyiq-dossiers

# Ollama Local AI Engine
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_PORT=11434
OLLAMA_DEFAULT_MODEL=llama3:8b

# Next.js Frontend Configuration
NEXT_PUBLIC_API_BASE_URL=https://localhost:7150/api/v1
NEXT_PUBLIC_APP_NAME=FacultyIQ
